@model FerreteriaValdivia.Models.Cliente
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Nuevo Cliente";
    string codigoSugerido = ViewBag.CodigoClienteSugerido as string
        ?? CodigosFerreteria.Cliente(Model != null && Model.IdCliente > 0 ? Model.IdCliente : 1);
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Agregar Nuevo Cliente</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label for="codigoClienteIngresado" class="form-label fw-semibold">Código de Cliente</label>
                    <input type="text"
                           id="codigoClienteIngresado"
                           name="codigoClienteIngresado"
                           class="form-control rounded-3"
                           value="@codigoSugerido"
                           placeholder="Ej. CLI-0001 o 1" />
                    <small class="text-muted">Formato: CLI-0001 (también acepta el número).</small>
                    <span asp-validation-for="IdCliente" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control rounded-3" placeholder="Ej. Juan Pérez" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Telefono" class="control-label fw-bold">Teléfono</label>
                    <input asp-for="Telefono" class="form-control rounded-3" placeholder="Ej. 70012345" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Direccion" class="control-label fw-bold">Dirección</label>
                    <input asp-for="Direccion" class="form-control rounded-3" placeholder="Ej. Av. 6 de Agosto #123" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                
                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Cliente" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}