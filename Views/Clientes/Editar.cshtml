@model FerreteriaValdivia.Models.Cliente
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Editar Cliente";
    string codigoClienteActual = ViewBag.CodigoClienteActual as string
        ?? (Model != null ? CodigosFerreteria.Cliente(Model.IdCliente) : "");
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Editar Cliente</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Editar" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <input type="hidden" asp-for="IdCliente" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label for="codigoClienteMostrado" class="control-label fw-bold">Código de Cliente</label>
                    <input type="text"
                           id="codigoClienteMostrado"
                           name="codigoClienteMostrado"
                           class="form-control rounded-3 bg-light"
                           value="@codigoClienteActual"
                           readonly />
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label fw-bold">Nombre</label>
                    <input asp-for="Nombre" class="form-control rounded-3" placeholder="Ej. Juan Pérez" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Telefono" class="control-label fw-bold">Teléfono</label>
                    <input asp-for="Telefono" class="form-control rounded-3" placeholder="Ej. 70012345" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Direccion" class="control-label fw-bold">Dirección</label>
                    <input asp-for="Direccion" class="form-control rounded-3" placeholder="Ej. Av. 6 de Agosto #123" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
                
                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Cambios" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}