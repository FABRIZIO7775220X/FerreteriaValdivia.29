@model IEnumerable<FerreteriaValdivia.Models.Cliente>
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Lista de Clientes";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Gestión de Clientes</h2>
        <div>
            <a asp-action="Crear" class="btn btn-dark shadow-sm">+ Nuevo Cliente</a>
            <a asp-action="Reporte" class="btn btn-outline-secondary ms-2 shadow-sm">📊 Analítica de Clientes</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Dirección</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@CodigosFerreteria.Cliente(item.IdCliente)</td>
                                <td class="fw-bold">@item.Nombre</td>
                                <td>@item.Telefono</td>
                                <td>@item.Direccion</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Editar" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-primary px-3 rounded-pill me-1">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-danger px-3 rounded-pill">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay clientes registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>