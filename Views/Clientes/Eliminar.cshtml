@model FerreteriaValdivia.Models.Cliente
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-2">Eliminar Cliente</h2>
    <h5 class="text-muted mb-3">¿Estás seguro de que deseas eliminar este registro?</h5>
    <hr />
    
    <div class="card p-4 border-0 shadow-sm rounded-4 col-md-6 bg-white">
        <dl class="row mb-4">
            <dt class="col-sm-4 fw-bold">Código:</dt>
            <dd class="col-sm-8">@CodigosFerreteria.Cliente(Model.IdCliente)</dd>

            <dt class="col-sm-4 fw-bold">Nombre:</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4 fw-bold">Teléfono:</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4 fw-bold">Dirección:</dt>
            <dd class="col-sm-8">@Model.Direccion</dd>
        </dl>

        <form asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="IdCliente" />
            <input type="submit" value="Sí, Eliminar" class="btn btn-danger rounded-pill px-4" />
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
        </form>
    </div>
</div>