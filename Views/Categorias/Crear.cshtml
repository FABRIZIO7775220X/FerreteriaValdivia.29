@model FerreteriaValdivia.Models.Categoria
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Nueva Categoría";
    int idCategoriaActual = Model?.IdCategoria ?? 0;
    string codigoSugerido = ViewBag.CodigoCategoriaSugerido as string
        ?? CodigosFerreteria.Categoria(idCategoriaActual > 0 ? idCategoriaActual : 1);
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Agregar Nueva Categoría</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label for="codigoCategoriaIngresado" class="control-label fw-bold">Código de Categoría</label>
                    <input type="text"
                           id="codigoCategoriaIngresado"
                           name="codigoCategoriaIngresado"
                           class="form-control rounded-3"
                           value="@codigoSugerido"
                           placeholder="Ej. CAT-01 a CAT-06 o 1 a 6" />
                    <small class="text-muted">Categorías fijas: CAT-01 a CAT-06 (acepta CAT-01 o el número 1).</small>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="NombreCategoria" class="control-label fw-bold">Nombre de Categoría</label>
                    <input asp-for="NombreCategoria" class="form-control rounded-3" placeholder="Ej. Herramientas Manuales" />
                    <span asp-validation-for="NombreCategoria" class="text-danger"></span>
                </div>
                
                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Categoría" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}