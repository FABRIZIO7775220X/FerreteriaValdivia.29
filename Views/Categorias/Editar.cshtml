@model FerreteriaValdivia.Models.Categoria
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Editar Categoría";
    int idCategoriaActual = Model?.IdCategoria ?? 0;
    string codigoCategoriaActual = ViewBag.CodigoCategoriaActual as string
        ?? (idCategoriaActual > 0 ? CodigosFerreteria.Categoria(idCategoriaActual) : "");
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Editar Categoría</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Editar" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="IdCategoria" />

                <div class="form-group mb-3">
                    <label for="codigoCategoriaMostrado" class="control-label fw-bold">Código de Categoría</label>
                    <input type="text"
                           id="codigoCategoriaMostrado"
                           name="codigoCategoriaMostrado"
                           class="form-control rounded-3 bg-light"
                           value="@codigoCategoriaActual"
                           readonly />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NombreCategoria" class="control-label fw-bold">Nombre de Categoría</label>
                    <input asp-for="NombreCategoria" class="form-control rounded-3" />
                    <span asp-validation-for="NombreCategoria" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Cambios" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}