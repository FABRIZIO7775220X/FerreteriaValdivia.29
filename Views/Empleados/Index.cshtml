@model IEnumerable<FerreteriaValdivia.Models.Empleado>
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Lista de Empleados";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Gestión de Empleados</h2>
        <div>
            <a asp-action="Crear" class="btn btn-dark shadow-sm">+ Nuevo Empleado</a>
            <a asp-action="Reporte" class="btn btn-outline-secondary ms-2 shadow-sm">📊 Analítica de Empleados</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Código Rol</th>
                        <th>Nombre</th>
                        <th>Cargo</th>
                        <th>Teléfono</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@CodigosFerreteria.Empleado(item.IdEmpleado, item.Cargo ?? "")</td>
                                <td class="fw-semibold text-secondary">@CodigosFerreteria.Rol(item.IdRol ?? 0)</td>
                                <td class="fw-bold">@item.Nombre</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">@item.Cargo</span>
                                </td>
                                <td>@item.Telefono</td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-outline-danger px-3 rounded-pill ms-1">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay empleados registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>