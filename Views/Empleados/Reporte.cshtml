@using FerreteriaValdivia
@{
    ViewData["Title"] = "Reporte de Empleados";
    int idEmpleadoTop = 0;
    if (ViewBag.IdEmpleadoTop != null)
    {
        int.TryParse(ViewBag.IdEmpleadoTop.ToString(), out idEmpleadoTop);
    }
    string cargoTop = ViewBag.CargoEmpleado as string ?? "";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">📊 Analítica de Desempeño de Empleados</h2>
        <span class="text-muted fw-semibold">Fecha: @DateTime.Now.ToShortDateString()</span>
    </div>

    <div class="row g-4">
        <!-- Tarjeta del Empleado con Más Ventas Registradas -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-primary border-4 h-100">
                <h5 class="text-muted text-uppercase fs-6 fw-bold">Empleado con Más Ventas Registradas</h5>
                @if (ViewBag.EmpleadoTop != null && ViewBag.EmpleadoTop != "Ninguno")
                {
                    <h3 class="fw-bold text-dark mt-2">
                        @if (idEmpleadoTop > 0)
                        {
                            <span>@CodigosFerreteria.Empleado(idEmpleadoTop, cargoTop) · </span>
                        }
                        <span>@ViewBag.EmpleadoTop</span>
                    </h3>
                    <p class="text-muted mb-1">Cargo institucional: <strong>@ViewBag.CargoEmpleado</strong></p>
                    <p class="text-primary mb-0 fw-bold fs-5">
                        💼 Total de ventas procesadas: @ViewBag.CantidadVentas
                    </p>
                }
                else
                {
                    <h3 class="fw-bold text-muted mt-2">Sin registros</h3>
                    <p class="text-muted mb-0">No hay empleados o transacciones vinculadas en el sistema actualmente.</p>
                }
            </div>
        </div>

        <!-- Tarjeta de Resumen General del Personal -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-success border-4 h-100">
                <h5 class="text-muted text-uppercase fs-6 fw-bold">Resumen de Plantilla</h5>
                <p class="text-muted mt-2 mb-1">Total de empleados registrados activamente:</p>
                <h3 class="fw-bold text-dark">@(ViewBag.TotalEmpleados ?? 0) Empleados</h3>
                <p class="text-success mb-0 fw-semibold">👥 Control y gobernabilidad del personal de caja y ventas</p>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Listado</a>
    </div>
</div>