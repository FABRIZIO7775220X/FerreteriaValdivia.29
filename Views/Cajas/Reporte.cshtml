@using FerreteriaValdivia
@{
    ViewData["Title"] = "Reporte de Cajas";
    int idCajaTop = ViewBag.CajaTop != null ? (int)ViewBag.CajaTop.id_Caja : 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">📊 Analítica de Flujo de Caja</h2>
        <span class="text-muted fw-semibold">Fecha: @DateTime.Now.ToShortDateString()</span>
    </div>

    <div class="row g-4">
        <!-- Tarjeta de Caja con Mayor Recaudación -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-success border-4 h-100">
                <h5 class="text-muted text-uppercase fs-6 fw-bold">Caja con Mayor Recaudación (Hoy)</h5>
                @if (ViewBag.CajaTop != null)
                {
                    <h3 class="fw-bold text-dark mt-2">@CodigosFerreteria.Caja(idCajaTop)</h3>
                    <p class="text-muted mb-1">Encargado: <strong>@ViewBag.EncargadoCaja</strong></p>
                    <p class="text-success mb-0 fw-bold fs-5">
                        💵 Recaudación: @ViewBag.MontoRecaudado Bs
                    </p>
                }
                else
                {
                    <h3 class="fw-bold text-muted mt-2">Sin registros</h3>
                    <p class="text-muted mb-0">No hay cierres o movimientos registrados para el día de hoy.</p>
                }
            </div>
        </div>

        <!-- Puedes agregar más tarjetas analíticas aquí si lo deseas -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-primary border-4 h-100">
                <h5 class="text-muted text-uppercase fs-6 fw-bold">Resumen Operativo</h5>
                <p class="text-muted mt-2 mb-1">Total de cajas gestionadas en la jornada:</p>
                <h3 class="fw-bold text-dark">@(ViewBag.TotalCajasHoy ?? 0) Cajas</h3>
                <p class="text-primary mb-0 fw-semibold">📈 Monitoreo activo de flujo de efectivo</p>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Listado</a>
    </div>
</div>