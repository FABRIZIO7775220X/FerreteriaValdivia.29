@model FerreteriaValdivia.Models.Caja
@using FerreteriaValdivia
@{
    ViewData["Title"] = "Cierre / Edición de Caja";
    string codigoCajaActual = ViewBag.CodigoCajaActual as string
        ?? (Model != null ? CodigosFerreteria.Caja(Model.id_Caja) : "");
    string codigoEmpleadoActual = ViewBag.CodigoEmpleadoActual as string
        ?? (Model != null && Model.id_Empleado > 0 ? CodigosFerreteria.Empleado(Model.id_Empleado, Model.Empleado?.Cargo ?? "") : "");
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Cierre o Edición de Caja</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <input type="hidden" asp-for="id_Caja" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="form-group mb-3">
                    <label for="codigoCajaIngresado" class="control-label fw-bold">Código de Caja</label>
                    <input type="text"
                           id="codigoCajaIngresado"
                           name="codigoCajaIngresado"
                           class="form-control rounded-3 bg-light"
                           value="@codigoCajaActual"
                           readonly />
                    <span asp-validation-for="id_Caja" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Fecha_Apertura" class="control-label fw-bold">Fecha Apertura</label>
                    <input asp-for="Fecha_Apertura" class="form-control rounded-3" type="date" />
                    <span asp-validation-for="Fecha_Apertura" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Monto_Inicial" class="control-label fw-bold">Monto Inicial (Bs)</label>
                    <input asp-for="Monto_Inicial" class="form-control rounded-3" type="number" step="0.01" />
                    <span asp-validation-for="Monto_Inicial" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Monto_Final" class="control-label fw-bold">Monto Final / Cierre (Bs)</label>
                    <input asp-for="Monto_Final" class="form-control rounded-3" type="number" step="0.01" />
                    <span asp-validation-for="Monto_Final" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label for="codigoEmpleadoIngresado" class="control-label fw-bold">Código Encargado</label>
                    <input type="text"
                           id="codigoEmpleadoIngresado"
                           name="codigoEmpleadoIngresado"
                           class="form-control rounded-3 mb-2"
                           value="@codigoEmpleadoActual"
                           placeholder="Ej. CAJ-EMP-0001, CONT-EMP-0001, EMP-0001 o 1" />
                    <select asp-for="id_Empleado" class="form-control rounded-3" asp-items="ViewBag.id_Empleado">
                        <option value="">-- Seleccione un Empleado --</option>
                    </select>
                    <small class="text-muted">Acepta CAJ-EMP-0001, CONT-EMP-0001, EMP-0001, el número o seleccionar en la lista.</small>
                    <span asp-validation-for="id_Empleado" class="text-danger"></span>
                </div>
                
                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Cambios" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}