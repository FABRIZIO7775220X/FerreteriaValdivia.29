@model FerreteriaValdivia.Models.Rol
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Editar Rol";
    string codigoRolActual = ViewBag.CodigoRolActual as string
        ?? (Model != null ? CodigosFerreteria.Rol(Model.id_Rol) : "");
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3">Editar Rol</h2>
                    <p class="text-muted mb-4">Modifique los datos del rol seleccionado.</p>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="id_Rol" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="codigoRolMostrado" class="form-label fw-semibold">Código del Rol</label>
                            <input type="text"
                                   id="codigoRolMostrado"
                                   name="codigoRolMostrado"
                                   class="form-control rounded-3 bg-light"
                                   value="@codigoRolActual"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreRol" class="form-label fw-semibold">Nombre del Rol</label>
                            <input asp-for="NombreRol" class="form-control rounded-3" />
                            <span asp-validation-for="NombreRol" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-dark rounded-pill px-4 shadow-sm">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>