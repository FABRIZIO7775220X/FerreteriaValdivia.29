@model IEnumerable<FerreteriaValdivia.Models.Rol>
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Analítica de Roles";
    var listaRoles = Model?.ToList() ?? new List<FerreteriaValdivia.Models.Rol>();
    var totalRoles = listaRoles.Count;
    var rolPrincipal = listaRoles.FirstOrDefault();
}

<div class="container-fluid mt-4">
    <h2 class="fw-bold mb-4">📊 Analítica de Roles y Acceses</h2>

    <div class="row">
        <!-- Tarjeta 1 -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <span class="text-uppercase text-muted small fw-bold">Rol Principal del Sistema</span>
                @if (rolPrincipal != null)
                {
                    <h3 class="fw-bold text-dark mt-2">
                        <span>@CodigosFerreteria.Rol(rolPrincipal.id_Rol) · </span>
                        <span>@rolPrincipal.NombreRol</span>
                    </h3>
                }
                else
                {
                    <h3 class="fw-bold text-dark mt-2">Sin registros</h3>
                }
                <p class="text-muted small">Perfiles configurados activamente en la base de datos.</p>
            </div>
        </div>

        <!-- Tarjeta 2 -->
        <div class="col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-primary border-4">
                <span class="text-uppercase text-muted small fw-bold">Estructura de Seguridad</span>
                <h3 class="fw-bold text-dark mt-2">@totalRoles Roles en el Sistema</h3>
                <p class="text-muted small mb-0">🔒 Control de accesos y permisos jerárquicos</p>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Volver al Listado</a>
    </div>
</div>