@model FerreteriaValdivia.Models.Rol
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Eliminar Rol";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 border-danger border-opacity-25">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3 text-danger">Eliminar Rol</h2>
                    <p class="text-muted mb-4">¿Está seguro de que desea eliminar este rol permanentemente?</p>

                    <div class="mb-3 p-3 bg-light rounded-3">
                        <span class="text-secondary small d-block">Código del Rol:</span>
                        <span class="fw-bold text-dark fs-6 d-block mb-2">@CodigosFerreteria.Rol(Model.id_Rol)</span>

                        <span class="text-secondary small d-block">Nombre del Rol:</span>
                        <span class="fw-bold text-dark fs-5">@Model.NombreRol</span>
                    </div>

                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" asp-for="id_Rol" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Sí, Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>