@model FerreteriaValdivia.Models.Pago
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Eliminar Pago";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="fw-bold text-danger mb-3">¿Estás seguro de eliminar este pago?</h2>
        <p class="text-muted mb-4">Esta acción no se puede deshacer.</p>

        <div>
            <dl class="row">
                <dt class="col-sm-4 fw-semibold">Código Pago:</dt>
                <dd class="col-sm-8">@CodigosFerreteria.Pago(Model.id_Pago)</dd>

                <dt class="col-sm-4 fw-semibold">Monto:</dt>
                <dd class="col-sm-8">@Model.Monto.ToString("N2") Bs</dd>

                <dt class="col-sm-4 fw-semibold">Método:</dt>
                <dd class="col-sm-8">@Model.MetodoPago</dd>
            </dl>
        </div>

        <!-- IMPORTANTE: El form debe tener method="post" y asp-action="Eliminar" -->
        <form asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="id_Pago" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm">Sí, Eliminar</button>
            </div>
        </form>
    </div>
</div>