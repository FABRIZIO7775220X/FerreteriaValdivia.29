@model IEnumerable<FerreteriaValdivia.Models.Pago>
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Gestión de Pagos";
}

<div class="container-fluid mt-4">
    <!-- Encabezado del Módulo -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Gestión de Pagos</h2>
            <p class="text-muted mb-0">Registro de transacciones y pagos de los clientes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Crear" class="btn btn-dark shadow-sm">+ Nuevo Pago</a>
            <a asp-action="Reporte" class="btn btn-outline-secondary shadow-sm bg-white">📊 Analítica de Pagos</a>
        </div>
    </div>

    <!-- Tabla Principal de Pagos -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Código Pago</th>
                        <th>Código Venta</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@CodigosFerreteria.Pago(item.id_Pago)</td>
                                <td>@CodigosFerreteria.Venta(item.id_Venta)</td>
                                <td class="fw-bold text-success">@item.Monto.ToString("N2") Bs</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.MetodoPago</span>
                                </td>
                                <td>@item.Fecha</td>
                                <td>@item.Hora</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.id_Pago" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@item.id_Pago" class="btn btn-sm btn-outline-danger px-3 rounded-pill ms-1">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay pagos registrados todavía.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>