@model IEnumerable<FerreteriaValdivia.Models.Producto>
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Inventario de Ferretería Valdivia</h2>
            <p class="text-muted mb-0">Control general de existencias, precios de venta y alertas de stock mínimo.</p>
        </div>
        <div>
            <a asp-action="Crear" class="btn btn-dark shadow-sm">+ Agregar Nuevo Producto</a>
            <a asp-action="MasVendido" class="btn btn-outline-secondary ms-2 shadow-sm">📊 Producto Más Vendido</a>            
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Nombre del Producto</th>
                        <th>Precio Venta</th>
                        <th>Stock Mín.</th>
                        <th>Stock Actual</th>
                        <!-- Nuevas columnas añadidas -->
                        <th>Cant. Venta</th>
                        <th>Categoría</th>
                        <th>Proveedor</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@CodigosFerreteria.Producto(item.CodigoProducto ?? "")</td>
                                <td>@item.Nombre</td>
                                <td class="fw-semibold text-success">Bs. @item.PrecioVenta.ToString("N2")</td>
                                <td>@item.StockMinimo</td>
                                <td class="fw-bold">@item.StockActual</td>
                                <!-- Valores de las nuevas columnas -->
                                <td>@item.CantidadVenta</td>
                                <td>@CodigosFerreteria.Categoria(item.IdCategoria ?? 0)</td>
                                <td>@CodigosFerreteria.Proveedor(item.IdProveedor ?? 0)</td>
                                <td>
                                    @if (item.StockActual <= item.StockMinimo)
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">¡Reponer Stock!</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">Disponible</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@item.CodigoProducto" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@item.CodigoProducto" class="btn btn-sm btn-outline-danger px-3 rounded-pill ms-1">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No hay productos registrados en el inventario.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>