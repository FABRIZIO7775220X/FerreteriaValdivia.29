@model FerreteriaValdivia.Models.Producto
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Crear Producto";
    int idCategoriaActual = Model?.IdCategoria ?? 0;
    int idProveedorActual = Model?.IdProveedor ?? 0;

    string codigoCategoriaInicial = ViewBag.CodigoCategoriaInicial as string
        ?? (idCategoriaActual > 0 ? CodigosFerreteria.Categoria(idCategoriaActual) : "");
    string codigoProveedorInicial = ViewBag.CodigoProveedorInicial as string
        ?? (idProveedorActual > 0 ? CodigosFerreteria.Proveedor(idProveedorActual) : "");
}

<div class="container mt-4">
    <h2 class="fw-bold mb-3">Agregar Nuevo Producto</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Crear" method="post" class="card p-4 border-0 shadow-sm rounded-4">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="CodigoProducto" class="control-label fw-bold">Código de Producto</label>
                    <input asp-for="CodigoProducto" type="text" class="form-control rounded-3" placeholder="Ej. PRD-0001 o 0001" />
                    <small class="text-muted">Formato: PRD-0001 (también acepta el número).</small>
                    <span asp-validation-for="CodigoProducto" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label fw-bold">Nombre del Producto</label>
                    <input asp-for="Nombre" class="form-control rounded-3" placeholder="Ej. Flexómetro" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PrecioVenta" class="control-label fw-bold">Precio de Venta (Bs.)</label>
                    <input asp-for="PrecioVenta" type="number" step="0.01" class="form-control rounded-3" placeholder="0.00" />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StockMinimo" class="control-label fw-bold">Stock Mínimo</label>
                    <input asp-for="StockMinimo" type="number" class="form-control rounded-3" placeholder="Ej. 5" />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StockActual" class="control-label fw-bold">Stock Actual</label>
                    <input asp-for="StockActual" type="number" class="form-control rounded-3" placeholder="Ej. 20" />
                    <span asp-validation-for="StockActual" class="text-danger"></span>
                </div>

                <!-- Campo de Cantidad de Venta actualizado -->
                <div class="form-group mb-3">
                    <label asp-for="CantidadVenta" class="control-label fw-bold">Cantidad de Venta</label>
                    <input asp-for="CantidadVenta" class="form-control rounded-3" type="number" min="0" step="1" placeholder="0" />
                    <span asp-validation-for="CantidadVenta" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="codigoCategoriaIngresado" class="control-label fw-bold">Código Categoría</label>
                    <input type="text"
                           id="codigoCategoriaIngresado"
                           name="codigoCategoriaIngresado"
                           class="form-control rounded-3"
                           value="@codigoCategoriaInicial"
                           placeholder="Ej. CAT-01 a CAT-06 o 1" />
                    <small class="text-muted">Formato: CAT-01 a CAT-06 (también acepta el número).</small>
                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="codigoProveedorIngresado" class="control-label fw-bold">Código Proveedor</label>
                    <input type="text"
                           id="codigoProveedorIngresado"
                           name="codigoProveedorIngresado"
                           class="form-control rounded-3"
                           value="@codigoProveedorInicial"
                           placeholder="Ej. PRV-0001 o 1" />
                    <small class="text-muted">Formato: PRV-0001 (también acepta el número).</small>
                    <span asp-validation-for="IdProveedor" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Guardar Producto" class="btn btn-dark rounded-pill px-4" />
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}