@model FerreteriaValdivia.Models.Producto
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Producto Más Vendido";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">📊 Analítica de Inventario</h2>
        <span class="text-muted fw-semibold">Fecha: @DateTime.Now.ToShortDateString()</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden col-md-8 mx-auto p-0">
        <div class="bg-dark text-white p-4 d-flex align-items-center">
            <h4 class="mb-0 fw-bold">🏆 Producto Estrella / Más Vendido</h4>
        </div>
        <div class="card-body p-4 bg-white">
            @if (Model != null)
            {
                <h3 class="fw-bold text-dark mb-1">@Model.Nombre</h3>
                <p class="text-muted mb-3">Código institucional: <strong class="text-secondary">@CodigosFerreteria.Producto(Model.CodigoProducto)</strong></p>
                <hr class="my-3" />
                
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block">Precio de Venta</span>
                            <span class="fw-bold text-success fs-5">Bs. @Model.PrecioVenta.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block">Stock en Almacén</span>
                            <span class="fw-bold text-dark fs-5">@Model.StockActual unidades</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 border border-success rounded-3 bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success">Total de Unidades Comercializadas:</span>
                    <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">@Model.CantidadVendida unidades</span>
                </div>
            }
            else
            {
                <div class="alert alert-warning rounded-3 mb-0">
                    No hay productos registrados o transacciones de venta vinculadas en el sistema todavía.
                </div>
            }

            <div class="mt-4 pt-2">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Inventario</a>
            </div>
        </div>
    </div>
</div>