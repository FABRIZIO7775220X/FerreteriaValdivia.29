@model FerreteriaValdivia.Models.DetalleVenta
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Eliminar Detalle de Venta";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 border-danger">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-danger mb-3">Eliminar Detalle</h2>
                    <p class="text-muted">¿Estás seguro de que deseas eliminar este registro de detalle de venta?</p>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Código Detalle:</dt>
                        <dd class="col-sm-8 fw-semibold">@CodigosFerreteria.DetalleVenta(Model.id_DetalleVenta)</dd>

                        <dt class="col-sm-4 text-muted">Producto:</dt>
                        <dd class="col-sm-8 fw-semibold">
                            <span class="fw-semibold">@CodigosFerreteria.Producto(Model.id_Producto)</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Producto?.Nombre))
                            {
                                <span class="text-muted">· @Model.Producto.Nombre</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Cantidad:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Cantidad</dd>

                        <dt class="col-sm-4 text-muted">Subtotal:</dt>
                        <dd class="col-sm-8 fw-semibold text-success">@Model.Subtotal.ToString("N2") Bs</dd>
                    </dl>

                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" asp-for="id_DetalleVenta" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Eliminar Definitivamente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>