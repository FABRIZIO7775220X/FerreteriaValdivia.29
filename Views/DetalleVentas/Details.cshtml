@model FerreteriaValdivia.Models.DetalleVenta
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Detalles del Ítem";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3">Detalle de Venta @CodigosFerreteria.DetalleVenta(Model.id_DetalleVenta)</h2>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Código Venta:</dt>
                        <dd class="col-sm-8 fw-semibold">@CodigosFerreteria.Venta(Model.id_Venta)</dd>

                        <dt class="col-sm-4 text-muted">Producto:</dt>
                        <dd class="col-sm-8 fw-semibold">
                            <span class="fw-semibold">@CodigosFerreteria.Producto(Model.id_Producto)</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Producto?.Nombre))
                            {
                                <span class="text-muted">· @Model.Producto.Nombre</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Cantidad:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.Cantidad</dd>

                        <dt class="col-sm-4 text-muted">Subtotal:</dt>
                        <dd class="col-sm-8 fw-semibold text-success">@Model.Subtotal.ToString("N2") Bs</dd>
                    </dl>
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                        <a asp-action="Editar" asp-route-id="@Model.id_DetalleVenta" class="btn btn-dark rounded-pill px-4 shadow-sm">Editar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>