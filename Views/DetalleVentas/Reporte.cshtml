@model FerreteriaValdivia.Models.DetalleVenta
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Reporte y Analítica de Detalle de Ventas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">📊 Reporte: Mayor Cantidad Vendida</h2>
            <p class="text-muted mb-0">Análisis del ítem con mayor volumen de unidades en una transacción.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">← Volver a Detalles</a>
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Tarjeta Destacada: Detalle con mayor cantidad de unidades -->
        <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4 mb-4">
            <div class="card-body">
                <span class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill fw-semibold">📦 Récord de Unidades Vendidas</span>
                <h1 class="display-4 fw-bold text-warning mb-3">@Model.Cantidad Unidades</h1>
                <div class="row g-3">
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Código Detalle</p>
                        <h5 class="fw-semibold">@CodigosFerreteria.DetalleVenta(Model.id_DetalleVenta)</h5>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Venta Asociada</p>
                        <h5 class="fw-semibold">@CodigosFerreteria.Venta(Model.id_Venta)</h5>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Producto</p>
                        <h5 class="fw-semibold">
                            <span>@CodigosFerreteria.Producto(Model.id_Producto)</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Producto?.Nombre))
                            {
                                <span class="text-light">· @Model.Producto.Nombre</span>
                            }
                        </h5>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Subtotal Generado</p>
                        <h5 class="fw-semibold text-success">@Model.Subtotal.ToString("N2") Bs</h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjetas de Estadísticas Generales -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Total de Líneas de Detalle</h6>
                        <h3 class="fw-bold text-dark">@ViewBag.TotalRegistros</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Suma Total de Unidades</h6>
                        <h3 class="fw-bold text-warning">@ViewBag.SumaTotalUnidades</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Ingreso Global en Detalles</h6>
                        <h3 class="fw-bold text-success">@(((decimal)ViewBag.IngresoTotalDetalles).ToString("N2")) Bs</h3>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center rounded-4 py-4" role="alert">
            <h4>No hay datos suficientes</h4>
            <p class="mb-0">@ViewBag.Mensaje</p>
        </div>
    }
</div>