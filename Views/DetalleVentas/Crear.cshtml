@model FerreteriaValdivia.Models.DetalleVenta
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Nuevo Detalle de Venta";
    int idVentaVal = Model != null ? Model.id_Venta : 0;
    string idProductoRaw = Model?.id_Producto?.ToString() ?? string.Empty;
    int.TryParse(idProductoRaw, out int idProductoNum);

    string codigoVentaInicial = ViewBag.CodigoVentaInicial as string
        ?? (idVentaVal > 0 ? CodigosFerreteria.Venta(idVentaVal) : string.Empty);

    string codigoProductoInicial = ViewBag.CodigoProductoInicial as string
        ?? (!string.IsNullOrWhiteSpace(idProductoRaw)
            ? CodigosFerreteria.NormalizarConPrefijo(idProductoRaw, "PRD", 4, idProductoNum)
            : string.Empty);
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h2 class="fw-bold mb-1">Nuevo Detalle de Venta</h2>
        <p class="text-muted mb-4">Asocie un producto y cantidad a una venta existente.</p>

        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="codigoVentaIngresado" class="form-label fw-semibold">Código de la Venta</label>
                <input type="text"
                       id="codigoVentaIngresado"
                       name="codigoVentaIngresado"
                       class="form-control rounded-3"
                       value="@codigoVentaInicial"
                       placeholder="Ej. VTA-0001 o 1" />
                <small class="text-muted">Formato: VTA-0001 (también acepta el número).</small>
                <span asp-validation-for="id_Venta" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="codigoProductoIngresado" class="form-label fw-semibold">Código del Producto</label>
                <input type="text"
                       id="codigoProductoIngresado"
                       name="codigoProductoIngresado"
                       class="form-control rounded-3"
                       value="@codigoProductoInicial"
                       placeholder="Ej. PRD-0001 o 1" />
                <small class="text-muted">Formato: PRD-0001 (también acepta el número).</small>
                <span asp-validation-for="id_Producto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cantidad" class="form-label fw-semibold">Cantidad</label>
                <input asp-for="Cantidad" class="form-control rounded-3" placeholder="0" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <!-- NUEVO CAMPO DE PRECIO UNITARIO -->
            <div class="mb-3">
                <label asp-for="PrecioUnitario" class="form-label fw-semibold">Precio Unitario (Bs)</label>
                <input asp-for="PrecioUnitario" class="form-control rounded-3" placeholder="0.00" />
                <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Subtotal" class="form-label fw-semibold">Subtotal (Bs)</label>
                <input asp-for="Subtotal" class="form-control rounded-3" placeholder="0.00" />
                <span asp-validation-for="Subtotal" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">Cancelar</a>
                <button type="submit" class="btn btn-dark px-4 rounded-3">Guardar Detalle</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}