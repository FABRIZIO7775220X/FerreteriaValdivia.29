@model FerreteriaValdivia.Models.Venta
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Reporte y Analítica de Ventas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">📊 Reporte y Analítica de Ventas</h2>
            <p class="text-muted mb-0">Análisis detallado del rendimiento de transacciones.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">← Volver a Ventas</a>
        </div>
    </div>

    @if (Model != null)
    {
        <!-- Tarjeta Destacada: Venta con el monto más alto -->
        <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4 mb-4">
            <div class="card-body">
                <span class="badge bg-success mb-2 px-3 py-2 rounded-pill fw-semibold">🌟 Venta Récord (Monto más alto)</span>
                <h1 class="display-4 fw-bold text-success mb-3">@Model.Total.ToString("N2") Bs</h1>
                <div class="row g-3">
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Código de Venta</p>
                        <h5 class="fw-semibold">@CodigosFerreteria.Venta(Model.id_Venta)</h5>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Fecha y Hora</p>
                        <h5 class="fw-semibold">@Model.Fecha.ToShortDateString() - @Model.Hora</h5>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Cliente</p>
                        <h5 class="fw-semibold">@(Model.Cliente?.Nombre ?? "Cliente General")</h5>
                        @if (Model.id_Cliente > 0)
                        {
                            <small class="text-light-emphasis">@CodigosFerreteria.Cliente(Model.id_Cliente)</small>
                        }
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted mb-1">Empleado</p>
                        <h5 class="fw-semibold">@(Model.Empleado?.Nombre ?? "Sin asignar")</h5>
                        @if (Model.id_Empleado > 0)
                        {
                            <small class="text-light-emphasis">@CodigosFerreteria.Empleado(Model.id_Empleado, Model.Empleado?.Cargo ?? "")</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjetas de Estadísticas Generales -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Total de Ventas Registradas</h6>
                        <h3 class="fw-bold text-dark">@(ViewBag.TotalVentas ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Ingreso Total General</h6>
                        <h3 class="fw-bold text-success">@(((decimal?)ViewBag.MontoTotalGeneral ?? 0m).ToString("N2")) Bs</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h6 class="text-muted">Promedio por Venta</h6>
                        <h3 class="fw-bold text-primary">@(((decimal?)ViewBag.PromedioVentas ?? 0m).ToString("N2")) Bs</h3>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center rounded-4 py-4" role="alert">
            <h4>No hay datos suficientes</h4>
            <p class="mb-0">@ViewBag.Mensaje</p>
        </div>
    }
</div>