@model FerreteriaValdivia.Models.Proveedor
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-2">Eliminar Proveedor</h2>
    <h5 class="text-muted mb-3">¿Estás seguro de que deseas eliminar este proveedor del sistema?</h5>
    <hr />

    <div class="card p-4 border-0 shadow-sm rounded-4 col-md-7 bg-white">
        <dl class="row mb-4">
            <dt class="col-sm-4 fw-bold">Código:</dt>
            <dd class="col-sm-8">@CodigosFerreteria.Proveedor(Model.IdProveedor)</dd>

            <dt class="col-sm-4 fw-bold">Nombre:</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4 fw-bold">Teléfono:</dt>
            <dd class="col-sm-8">@Model.Telefono</dd>

            <dt class="col-sm-4 fw-bold">Ubicación:</dt>
            <dd class="col-sm-8">@Model.Ubicacion</dd>
        </dl>

        <form asp-action="Eliminar" method="post">
            <input type="hidden" asp-for="IdProveedor" />
            <input type="submit" value="Sí, Eliminar Definitivamente" class="btn btn-danger rounded-pill px-4" />
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-2">Cancelar</a>
        </form>
    </div>
</div>