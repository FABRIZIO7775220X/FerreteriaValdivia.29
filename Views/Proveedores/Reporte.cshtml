@model FerreteriaValdivia.Models.Proveedor
@using FerreteriaValdivia

@{
    ViewData["Title"] = "Reporte de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">📊 Analítica de Proveedores</h2>
        <span class="text-muted fw-semibold">Fecha: @DateTime.Now.ToShortDateString()</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden col-md-8 mx-auto p-0">
        <div class="bg-dark text-white p-4 d-flex align-items-center">
            <h4 class="mb-0 fw-bold">🚚 Proveedor Líder en Registros</h4>
        </div>
        <div class="card-body p-4 bg-white">
            @if (Model != null)
            {
                <h3 class="fw-bold text-dark mb-1">@Model.Nombre</h3>
                <p class="text-muted mb-3">Ubicación principal: <strong class="text-secondary">@Model.Ubicacion</strong></p>
                <hr class="my-3" />
                
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block">Teléfono de Contacto</span>
                            <span class="fw-bold text-dark fs-5">📞 @Model.Telefono</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light">
                            <span class="text-muted small d-block">Código Interno</span>
                            <span class="fw-bold text-secondary fs-5">@CodigosFerreteria.Proveedor(Model.IdProveedor)</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 border border-success rounded-3 bg-success bg-opacity-10 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-success">Total de Proveedores Registrados:</span>
                    <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">@(ViewBag.TotalProveedores ?? 0) total</span>
                </div>
            }
            else
            {
                <div class="alert alert-warning rounded-3 mb-0">
                    No hay proveedores registrados en el sistema todavía.
                </div>
            }

            <div class="mt-4 pt-2">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>